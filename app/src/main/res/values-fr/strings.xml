    <string name="terms_s1_title">1. Objet de 3ditdoc</string>
    <string name="terms_s1_body">3ditdoc est un outil gratuit et 100% local permettant d\'ajouter un calque visuel sur des PDF sans modifier l\'original.</string>
    <string name="terms_s2_title">2. Protection du fichier original</string>
    <string name="terms_s2_body">Le fichier source n\'est jamais modifié automatiquement et un nouveau PDF est enregistré séparément.</string>
    <string name="terms_s3_title">3. Responsabilité</string>
    <string name="terms_s3_body">Vous êtes seul responsable du contenu et des signatures ajoutées aux documents.</string>
    <string name="terms_s4_title">4. Aucune limite</string>
    <string name="terms_s4_body">Sans compte, sans publicité en édition et sans filigrane.</string>

    <string name="privacy_s1_title">1. Traitement 100% local</string>
    <string name="privacy_s1_body">Tous les documents sont traités localement sur votre téléphone sans envoi vers des serveurs externes.</string>
    <string name="privacy_s2_title">2. Aucune collecte de données</string>
    <string name="privacy_s2_body">Aucune donnée personnelle n\'est collectée, suivie ou partagée.</string>
    <string name="privacy_s3_title">3. Permissions minimales</string>
    <string name="privacy_s3_body">Sélecteur système Android pour les PDF, Photo Picker sans permission étendue et appareil photo uniquement sur votre action.</string>
    <string name="privacy_s4_title">4. Cache temporaire</string>
    <string name="privacy_s4_body">Les copies de travail restent uniquement en cache local temporaire.</string>

    <string name="about_s1_title">Aperçu fidèle garanti</string>
    <string name="about_s1_body">3ditdoc intègre les polices réelles et ajoute uniquement un calque au-dessus du PDF d\'origine.</string>
    <string name="about_s2_title">Astuces rapides</string>
    <string name="about_s2_body">• Touchez un élément pour le déplacer, redimensionner ou pivoter.\n• Touchez l\'icône œil pour masquer votre calque et vérifier l\'original.</string>

